// ============================================================================
// Grafana Alloy configuration
// Alloy is the Grafana observability data collector (formerly Grafana Agent)
// Official documentation: https://grafana.com/docs/alloy/latest/
//
// Data flow:
// Application -> OTLP Receiver -> Batch Processor -> Exporters -> Backend storage
//   - Logs    -> Loki
//   - Metrics -> Prometheus
//   - Traces  -> Tempo
// ============================================================================

// OTLP receiver configuration
// Receive logs, metrics, and traces simultaneously
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Batch processor configuration
// Combine telemetry items into batches for more efficient transmission
otelcol.processor.batch "default" {
  output {
    logs    = [otelcol.exporter.loki.default.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Loki exporter configuration
// Send log data to Grafana Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.loki_server.receiver]
}

// Loki write component
// Push log data to the Loki server
loki.write "loki_server" {
  endpoint {
    url = "http://fba_loki:3100/loki/api/v1/push"
  }
}

// Prometheus exporter configuration
// Send metrics to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.prom_server.receiver]
}

// Prometheus remote write component
// Push metrics to the Prometheus server
prometheus.remote_write "prom_server" {
  endpoint {
    url = "http://fba_prometheus:9090/api/v1/write"
  }
}

// Scrape Prometheus internal metrics
// Monitor the Prometheus server itself
prometheus.scrape "prometheus" {
	targets = [{
		__address__ = "fba_prometheus:9090",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_prometheus"
	scrape_interval = "15s"
}

// Scrape FastAPI backend service metrics
// Monitor FastAPI application performance and business metrics
prometheus.scrape "fba_server" {
	targets = [{
		__address__ = "fba_server:8001",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_server"
	metrics_path    = "/metrics/"
	scrape_interval = "5s"
	scrape_timeout  = "5s"
}

// Scrape Granian server metrics
// Monitor Granian ASGI server performance metrics
prometheus.scrape "fba_granian" {
	targets = [{
		__address__ = "fba_server:8002",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_granian"
	scrape_interval = "5s"
	scrape_timeout  = "5s"
}

// Scrape Celery Exporter metrics
// Monitor the Celery asynchronous task queue
prometheus.scrape "fba_celery_exporter" {
	targets = [{
		__address__ = "fba_celery_exporter:9808",
	}]
	forward_to      = [prometheus.remote_write.prom_server.receiver]
	job_name        = "fba_celery_exporter"
	scrape_interval = "15s"
	scrape_timeout  = "15s"
}

// Tempo exporter configuration
// Send trace data to Grafana Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "fba_tempo:4317"
    tls {
        insecure = true
    }
  }
}
